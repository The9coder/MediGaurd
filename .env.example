# Local Docker Compose configuration only. Do not use these example values for real
# health data. Keep the filled-in .env file out of version control.
FLASK_ENV=development

# Generate a unique random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-random-value-of-at-least-32-characters

# OIDC provider (register http://localhost:5000/auth/callback for local testing).
OIDC_ISSUER=https://identity.example.org
OIDC_CLIENT_ID=mediguard
OIDC_CLIENT_SECRET=replace-with-provider-secret
OIDC_ADMIN_ROLE=admin
OIDC_ROLE_CLAIM=roles
TRUSTED_PROXY_HOPS=0
TRUSTED_HOSTS=localhost,127.0.0.1

# PostgreSQL superuser is used only by the database entrypoint initialization.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-admin-password
DB_USER=mediguard_app
DB_PASSWORD=replace-with-a-unique-app-password
DATABASE_URL=postgresql://mediguard_app:replace-with-url-encoded-app-password@db:5432/mediguard
DB_SSLMODE=disable

# Redis is private to the Docker network. URL-encode special characters in the password.
REDIS_PASSWORD=replace-with-a-unique-redis-password
REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379/0

# Predictions stay disabled by default. Enable only after clinical and regulatory approval,
# and after installing a trusted model artifact and its SHA-256 and validation reference.
ENABLE_PATIENT_RECORDS=false
PATIENT_DATA_GOVERNANCE_REFERENCE=
ENABLE_PREDICTIONS=false
MODEL_SHA256=
MODEL_VALIDATION_REFERENCE=
