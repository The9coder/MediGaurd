# MediGuard – Environment variables template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string
DEBUG=false

# JWT
JWT_SECRET=replace-with-another-long-random-string
JWT_EXPIRY_HOURS=1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=mediguard
DB_PASSWORD=replace-with-strong-password
DB_NAME=mediguard_db
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# Logging
LOG_FILE=logs/access.log
LOG_LEVEL=INFO

# Model
MODEL_PATH=app/model/heart_disease_model.pkl
